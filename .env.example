# Upstash Redis — auto-set when connected in Vercel Storage
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Wallet auto-tracker
TRACKED_WALLET=4mugTfk3Aw5X4rNTw8w3fgdAtKo76FVM4a8c9PNS1zSh
MIN_PROFIT_USD=100

# Helius (required for real-time + cron backup)
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=choose-a-long-random-string

# GMGN (optional — improves PnL accuracy)
GMGN_API_KEY=
GMGN_API_BASE=https://openapi.gmgn.ai

# Protect cron/setup endpoints (Vercel cron sends Bearer CRON_SECRET)
CRON_SECRET=choose-a-long-random-string
