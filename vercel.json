{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/cron/scan-wallet.js": {
      "maxDuration": 60
    },
    "api/webhooks/helius.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/scan-wallet",
      "schedule": "0 8 * * *"
    }
  ]
}
